# Servidor de salas (server/server.mjs). Nenhum valor aqui é segredo.
# O servidor lê variáveis de ambiente; ele não carrega este arquivo sozinho
# (use `node --env-file=.env server/server.mjs` ou exporte as variáveis).
OMEGA_SERVER_PORT=8787
# Origens (separadas por vírgula) autorizadas a abrir WebSocket. Use * só em testes locais.
OMEGA_CORS_ORIGIN=http://localhost:4173,http://127.0.0.1:4173
# Participantes por sala (2 jogadores + espectadores) e total de salas.
OMEGA_ROOM_LIMIT=32
OMEGA_MAX_ROOMS=500
# Tempo de vida de uma sala sem atividade, em milissegundos (padrão: 3 horas).
OMEGA_ROOM_TTL_MS=10800000
# Limites por endereço IP.
OMEGA_RATE_LIMIT=40
OMEGA_MAX_CONNECTIONS_PER_IP=16
# Salas abertas criadas pelo mesmo IP (impede que um cliente ocupe todas as OMEGA_MAX_ROOMS).
OMEGA_MAX_ROOMS_PER_IP=8
# Defina 1 se o servidor estiver atrás de um proxy reverso que acrescenta X-Forwarded-For
# (vale o último endereço da lista, o que o proxy acrescentou).
OMEGA_TRUST_PROXY=0
